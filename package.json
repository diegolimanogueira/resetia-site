{
  "name": "resetia-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "serve out -l 4173 --no-clipboard",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:update": "playwright test --update-snapshots",
    "lhci": "lhci autorun",
    "check:html": "html-validate \"out/**/*.html\"",
    "check:falta": "node scripts/check-falta.mjs",
    "check:size": "size-limit",
    "knip": "knip",
    "images": "node scripts/optimize-images.mjs && node scripts/og-image.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "prepare": "husky || true",
    "e2e:baselines": "docker run --rm -v \"$PWD\":/work -v /work/node_modules -w /work -e CI=1 mcr.microsoft.com/playwright:v1.64.1-noble bash -lc \"npm ci && npx playwright test --project=reduced-motion --project=reduced-motion-mobile tests/e2e/visual.spec.ts --update-snapshots\"",
    "deploy:do": "bash scripts/deploy-do.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "cn": "^0.5.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.59.0",
    "motion": "^14.3.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.22.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource/inter": "^5.3.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@size-limit/file": "^14.2.0",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "html-validate": "^11.16.4",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "knip": "^6.42.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "serve": "^14.2.6",
    "sharp": "^0.35.5",
    "size-limit": "^14.2.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "24.x"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,cjs,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,md,json,yml,yaml}": [
      "prettier --write"
    ]
  }
}
