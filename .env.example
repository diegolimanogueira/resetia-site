# Copie para .env.local. Todas são opcionais; sem elas o site funciona sem analytics.

# URL pública do site (metadados e sitemap usam src/content/site.ts; esta var é para o deploy/smoke).
NEXT_PUBLIC_SITE_URL=https://www.resetia.com.br

# Analytics: "umami" (padrão) ou "ga4". Sem NEXT_PUBLIC_ANALYTICS_ID nada é carregado.
NEXT_PUBLIC_ANALYTICS_PROVIDER=umami
NEXT_PUBLIC_ANALYTICS_ID=
# Só para Umami self-hosted (padrão: https://cloud.umami.is)
NEXT_PUBLIC_ANALYTICS_HOST=

# Staging (GitHub Pages): prefixo das rotas/assets e noindex. Em produção, deixar vazio/false.
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_STAGING=false
