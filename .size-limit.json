[
  {
    "name": "JavaScript (todos os chunks, gzip)",
    "path": "out/_next/static/chunks/**/*.js",
    "limit": "360 kB",
    "gzip": true
  },
  {
    "name": "CSS (gzip)",
    "path": "out/_next/static/**/*.css",
    "limit": "20 kB",
    "gzip": true
  },
  {
    "name": "Imagens da home (logos e ícone do hero)",
    "path": ["public/brand/logo-light.webp", "public/brand/logo-dark.webp", "public/brand/icone-light.webp"],
    "limit": "50 kB",
    "gzip": false
  }
]
