[
  {
    "name": "JavaScript (todos os chunks, gzip)",
    "path": "out/_next/static/chunks/**/*.js",
    "limit": "220 kB",
    "gzip": true
  },
  {
    "name": "CSS (gzip)",
    "path": "out/_next/static/**/*.css",
    "limit": "20 kB",
    "gzip": true
  },
  {
    "name": "Imagens da home (logo + ícone do hero)",
    "path": ["public/brand/logo-dark.webp", "public/brand/icone-dark.webp"],
    "limit": "40 kB",
    "gzip": false
  }
]
