[
  {
    "name": "JavaScript (todos os chunks, gzip)",
    "path": "out/_next/static/chunks/**/*.js",
    "limit": "300 kB",
    "gzip": true
  },
  {
    "name": "CSS (gzip)",
    "path": "out/_next/static/**/*.css",
    "limit": "20 kB",
    "gzip": true
  },
  {
    "name": "Imagens da home (porta + logo)",
    "path": ["public/brand/porta.avif", "public/brand/porta.webp", "public/brand/logo-dark.webp"],
    "limit": "120 kB",
    "gzip": false
  }
]
